# Templated routing config for Traefik (see docker-compose.yml's `traefik`
# service, --providers.file). Used instead of Traefik's Docker-socket
# provider (the usual docker-compose-labels pattern) because Traefik's
# bundled Docker client is incompatible with this host's Docker Engine
# version -- it hardcodes an old API version (1.24) that this Engine's
# MinAPIVersion (1.40) rejects outright, and DOCKER_API_VERSION isn't
# honored by Traefik's provider even on the latest v3.x. The file provider
# sidesteps this entirely (no docker.sock mount needed at all, which is
# also one less container with access to the Docker socket -- a modest
# security win) since this app doesn't need dynamic service discovery: it's
# one fixed backend.
#
# This is a TEMPLATE, not the file Traefik actually reads: Traefik's file
# provider does not expand variables on its own, so a hand-hardcoded
# hostname here used to have to be kept in sync with APP_DOMAIN in .env by
# hand -- it's now templated instead. The `traefik-config` one-shot service
# in docker-compose.yml renders this into the `traefik-dynamic-config`
# volume (substituting the placeholder below with APP_DOMAIN's value from
# .env) before Traefik starts, so the domain is genuinely driven by .env,
# not hardcoded anywhere in the repo. Re-running `docker compose up -d`
# after changing APP_DOMAIN re-renders and Traefik's own
# --providers.file.watch=true picks up the change without a restart.
#
# NOTE for anyone editing this file: the placeholder token below is matched
# by a literal sed substitution (see docker-compose.yml's `traefik-config`
# entrypoint) -- it's deliberately not repeated anywhere else in this
# comment block so the rendered output doesn't corrupt this prose too.
http:
  routers:
    openvpn-toolkit:
      rule: "Host(`${APP_DOMAIN}`)"
      entryPoints:
        - websecure
      service: openvpn-toolkit
      tls:
        certResolver: letsencrypt

    # Traefik's own internal API + ping (see docker-compose.yml's
    # --api=true, --ping=true, and --entrypoints.traefik.address=:8080) --
    # both bound only to the "traefik" entrypoint, which is never
    # published to the host, so these routers are only reachable from
    # other containers on the compose network (i.e. the app service
    # calling them for the Health page), never publicly. With the File
    # provider, api@internal/ping@internal each need an explicit router
    # like any other service -- neither is auto-exposed just by
    # --api=true/--ping=true.
    traefik-internal-api:
      rule: "PathPrefix(`/api`)"
      entryPoints:
        - traefik
      service: api@internal

    traefik-internal-ping:
      rule: "PathPrefix(`/ping`)"
      entryPoints:
        - traefik
      service: ping@internal

  services:
    openvpn-toolkit:
      loadBalancer:
        servers:
          # "app" resolves via Docker Compose's built-in DNS to the `app`
          # service on the shared compose network -- no service discovery
          # needed.
          - url: "http://app:8000"
