# Templated routing config for Traefik (see docker-compose.yml's `traefik`
# service, --providers.file). Used instead of Traefik's Docker-socket
# provider (the usual docker-compose-labels pattern) because Traefik's
# bundled Docker client is incompatible with this host's Docker Engine
# version -- it hardcodes an old API version (1.24) that this Engine's
# MinAPIVersion (1.40) rejects outright, and DOCKER_API_VERSION isn't
# honored by Traefik's provider even on the latest v3.x. The file provider
# sidesteps this entirely (no docker.sock mount needed at all, which is
# also one less container with access to the Docker socket -- a modest
# security win) since this app doesn't need dynamic service discovery: it's
# one fixed backend.
#
# This is a TEMPLATE, not the file Traefik actually reads: Traefik's file
# provider does not expand variables on its own, so a hand-hardcoded
# hostname here used to have to be kept in sync with APP_DOMAIN in .env by
# hand -- it's now templated instead. The `traefik-config` one-shot service
# in docker-compose.yml renders this into the `traefik-dynamic-config`
# volume (substituting the placeholder below with APP_DOMAIN's value from
# .env) before Traefik starts, so the domain is genuinely driven by .env,
# not hardcoded anywhere in the repo. Re-running `docker compose up -d`
# after changing APP_DOMAIN re-renders and Traefik's own
# --providers.file.watch=true picks up the change without a restart.
#
# NOTE for anyone editing this file: the placeholder tokens below (APP_DOMAIN,
# CLIENT_IP_TRUST_MIDDLEWARE) are matched by literal sed substitutions (see
# docker-compose.yml's `traefik-config` entrypoint) -- they're deliberately
# not repeated anywhere else in this comment block so the rendered output
# doesn't corrupt this prose too.
#
# CLIENT_IP_TRUST_MIDDLEWARE selects which of the two middlewares below the
# main router uses -- "cloudflare-only" (real enforcement: only Cloudflare's
# published edge ranges may reach this app at all, set when APP_DOMAIN is
# auto-detected as Cloudflare-proxied) or "allow-all" (no IP-source
# enforcement, for direct/other-DNS-provider deployments, where the app
# instead trusts Traefik's own X-Forwarded-For -- see client_ip.py). Chosen
# and written to .env by setup-new-machine.sh's detect_proxy_mode(); see
# config.py's CLIENT_IP_HEADER docstring for the paired app-side setting.
http:
  middlewares:
    allow-all:
      ipAllowList:
        sourceRange:
          - "0.0.0.0/0"
          - "::/0"

    # Cloudflare's published edge IP ranges -- pinned from
    # https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
    # as of 2026-08-11. These change rarely but not never; re-verify against
    # those URLs occasionally (Traefik's file provider can't fetch them at
    # runtime, so this list has to be committed, not dynamic).
    cloudflare-only:
      ipAllowList:
        sourceRange:
          - "173.245.48.0/20"
          - "103.21.244.0/22"
          - "103.22.200.0/22"
          - "103.31.4.0/22"
          - "141.101.64.0/18"
          - "108.162.192.0/18"
          - "190.93.240.0/20"
          - "188.114.96.0/20"
          - "197.234.240.0/22"
          - "198.41.128.0/17"
          - "162.158.0.0/15"
          - "104.16.0.0/13"
          - "104.24.0.0/14"
          - "172.64.0.0/13"
          - "131.0.72.0/22"
          - "2400:cb00::/32"
          - "2606:4700::/32"
          - "2803:f800::/32"
          - "2405:b500::/32"
          - "2405:8100::/32"
          - "2a06:98c0::/29"
          - "2c0f:f248::/32"

  routers:
    cyferio:
      rule: "Host(`${APP_DOMAIN}`)"
      entryPoints:
        - websecure
      service: cyferio
      middlewares:
        - ${CLIENT_IP_TRUST_MIDDLEWARE}
      tls:
        certResolver: letsencrypt

    # VPN-internal ingestion path (host-scripts/openvpn-mac-addr-check.py's
    # report_rejection()) -- used to hit the app container directly on a
    # host-IP-bound port (see docker-compose.yml's "Zero-downtime rollout"
    # comment for why that moved here instead). No Host()/PathPrefix rule
    # needed: this entrypoint is only reachable via VPN_TUNNEL_IP in the
    # first place (see docker-compose.yml's traefik service `ports:`),
    # never from the public internet, so there's nothing else on it to
    # discriminate between -- catch-all is the correct rule, same posture
    # the app container's own direct port bind had before. Same `cyferio`
    # service/backend list as the public router above -- one set of
    # servers/health checks either way, just reached over a second
    # entrypoint.
    cyferio-vpninternal:
      rule: "PathPrefix(`/`)"
      entryPoints:
        - vpninternal
      service: cyferio

    # Traefik's own internal API + ping (see docker-compose.yml's
    # --api=true, --ping=true, and --entrypoints.traefik.address=:8080) --
    # both bound only to the "traefik" entrypoint, which is never
    # published to the host, so these routers are only reachable from
    # other containers on the compose network (i.e. the app service
    # calling them for the Health page), never publicly. With the File
    # provider, api@internal/ping@internal each need an explicit router
    # like any other service -- neither is auto-exposed just by
    # --api=true/--ping=true.
    traefik-internal-api:
      rule: "PathPrefix(`/api`)"
      entryPoints:
        - traefik
      service: api@internal

    traefik-internal-ping:
      rule: "PathPrefix(`/ping`)"
      entryPoints:
        - traefik
      service: ping@internal

    # Prometheus-format request metrics (see docker-compose.yml's
    # --metrics.prometheus=* flags) -- same "traefik" entrypoint, same
    # never-published-publicly posture as the two routers above. prometheus@
    # internal is the metrics registry's own internal service name, exactly
    # like api@internal/ping@internal.
    traefik-internal-metrics:
      rule: "PathPrefix(`/metrics`)"
      entryPoints:
        - traefik
      service: prometheus@internal

  services:
    # Zero-downtime rollout (see docker-compose.yml's app-blue/app-green
    # comment for the full design): BOTH slots are listed here permanently
    # -- nothing about this file needs to change during a rollout. Exactly
    # one of the two is normally actually running (docker-compose.yml's
    # `profiles:`); the other's hostname simply fails to resolve (no
    # container = no DNS entry on the compose network), which this
    # loadBalancer's own healthCheck below treats the same as any other
    # backend failure -- quietly excluded from rotation, not an error.
    # During the brief window upgrade.sh runs both at once, Traefik
    # health-checks each independently and only ever sends live traffic to
    # whichever ones are actually passing -- this IS the mechanism that
    # makes the rollout zero-downtime: the moment the new slot's /healthz
    # starts passing, Traefik starts routing to it -- no explicit "cutover"
    # step, no re-templating this file, no Traefik restart/reload.
    cyferio:
      loadBalancer:
        servers:
          - url: "http://app-blue:8000"
          - url: "http://app-green:8000"
        # 1s/1s, not the more typical 5s/3s -- this interval directly
        # bounds how long Traefik can keep sending requests to a
        # container that just stopped (upgrade.sh's old-slot teardown)
        # before noticing and evicting it. Measured locally 2026-08-21
        # against the real app image: 5s/3s let ~2-3% of requests hit a
        # 502/timeout during that transition under a 10 req/s synthetic
        # hammer; 1s/1s brought that down to ~0.7% (1 of 150) under the
        # same test -- about as good as a passive-health-check load
        # balancer gets without the file provider supporting an explicit
        # "drain this backend first" signal. Cheap either way: this is
        # just an unauthenticated GET to a two-container list, not a
        # meaningful load on the app itself.
        healthCheck:
          path: /healthz
          interval: "1s"
          timeout: "1s"
