[Unit]
Description=Refresh GeoLite2-Country database for OpenVPN Toolkit country restrictions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/cyferio/geoip-update.sh
StandardOutput=append:/var/log/openvpn-geoip-update.log
StandardError=append:/var/log/openvpn-geoip-update.log
