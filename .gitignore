# Never commit real client configs, keys, or the MAC-binding database --
# these are per-install secrets/PII, not part of the toolkit itself.
*.ovpn
openvpn_db.txt
vpn-tools.conf
!vpn-tools.conf.example

*.key
*.crt
*.pem
*.csr

# Editor/OS cruft
.DS_Store
*.swp

# Python
__pycache__/
*.pyc
.venv/

# Web app runtime artifacts, never the code itself. docker-compose.yml and
# .env now live at the repo root (moved out of app/); app/data/ stays put
# since that's still where the app's SQLite file / bind mount lives.
/.env
app/data/
app/pgdata/
GeoLite2-Country/
*.mmdb

# Host-executor deploy key (see .env.example's "Host executor" section) --
# per-install secret, same rationale as the block at the top of this file.
# The private key has no file extension, so *.key above doesn't catch it.
/secrets/

# Per-host Compose overrides (e.g. mounting the host-executor deploy key
# above only on the machines that have it) -- never shared across hosts.
docker-compose.override.yml
