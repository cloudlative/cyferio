# Template for docker-compose.override.yml -- gitignored (see .gitignore),
# auto-merged by `docker compose` with docker-compose.yml on every `up`/
# `config` call, no extra flag needed. Copy this file to
# docker-compose.override.yml and it takes effect immediately.
#
# `setup-new-machine.sh` writes this file for you automatically (Phase 4)
# when it sets up the host-executor SSH key -- you normally don't need to
# do this by hand. This template exists for machines that were set up
# manually, or where you want to enable the mount without re-running the
# full bootstrap script.
#
# Why an override file instead of editing docker-compose.yml itself: any
# local edit to that tracked file diverges this host from git permanently,
# and `git pull` / upgrade.sh's clean-tree preflight check refuses to
# fast-forward over local edits to tracked files, forever, on every future
# release. Keep docker-compose.yml itself untouched on every host --
# this file is where host-specific config belongs instead.
# Applied to BOTH app-blue and app-green (not a single `app` service --
# see docker-compose.yml's "Zero-downtime rollout" comment for why there
# are two): either one can be the currently-active slot, and a rollout
# briefly runs both at once, so both need this mount for the live-session
# actions to keep working regardless of which slot answers a given
# request.
services:
  app-blue:
    volumes:
      - ${HOST_SSH_KEY_SOURCE_PATH:-./secrets/cyferio-deploy-key}:/run/secrets/cyferio-deploy-key:ro
  app-green:
    volumes:
      - ${HOST_SSH_KEY_SOURCE_PATH:-./secrets/cyferio-deploy-key}:/run/secrets/cyferio-deploy-key:ro
