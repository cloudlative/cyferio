# Copy this file to .env and fill in real values before running.
# Never commit a real .env -- it's already in .gitignore.

# Database: Postgres is the default -- leave DATABASE_URL unset (as below)
# and just set POSTGRES_PASSWORD; config.py's _default_database_url() builds
# postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
# automatically (host "postgres" is the docker-compose `postgres` service
# name, only reachable from other containers on the same compose network,
# never published to the host). Uncomment DATABASE_URL below only to
# override explicitly -- e.g. a sqlite:///./data/app.db file for a
# zero-dependency local/dev run with no postgres container at all, or a
# postgresql:// URL pointing somewhere other than the bundled service.
# DATABASE_URL=sqlite:///./data/app.db

# --- Postgres service credentials (read by BOTH the `postgres` container
# itself and, via _default_database_url() above, this app -- see
# docker-compose.yml). Required unless DATABASE_URL is set explicitly above.
# Generate a strong password, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=vpnadmin
POSTGRES_PASSWORD=
POSTGRES_DB=vpnadmin

# --- Traefik / TLS (see docker-compose.yml's `traefik` service) ---
# Public hostname Traefik requests a Let's Encrypt cert for and routes to
# this app. Must already resolve (A/AAAA) to this host's public IP.
# APP_DOMAIN=vpn-mgmt.example.com

# Contact email Let's Encrypt uses for expiry/problem notices about this
# cert -- not shown anywhere in the app UI. Use a real, monitored mailbox
# you control, not a placeholder domain (Let's Encrypt does send to it).
# ACME_EMAIL=you@example.com

# --- Image tag (see docker-compose.yml's `app` service) ---
# Which ghcr.io/cloudlative/openvpn-toolkit-app tag `docker compose pull`
# fetches. Leave unset to track `latest` (whatever the most recently
# pushed release tag published -- see app/README.md's Releases section;
# ordinary commits to master don't publish a new image at all). Pin to a
# specific release instead with its version number -- note: NO leading
# "v", even though the git tag is vX.Y.Z (metadata-action's semver tagging
# strips it, so git tag v1.0.1 publishes image tag "1.0.1").
# IMAGE_TAG=1.0.1

# Leave unset/empty for Let's Encrypt's production CA. Point at the
# staging directory below first when standing this up or changing the
# domain, to avoid burning production rate-limit attempts on a config
# that isn't verified working yet -- staging certs aren't
# browser-trusted, so only flip this back to empty/production once a
# staging cert issues successfully (see Traefik's Let's Encrypt docs).
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Marks the session cookie Secure -- only turn on once Traefik (or some
# other TLS terminator) is actually in front of this app, otherwise
# browsers will silently refuse to send the cookie back over http:// and
# nobody can log in.
# SESSION_HTTPS_ONLY=true

# REQUIRED in any real deployment -- generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Paths to the toolkit scripts this app wraps. In Docker these point at the
# bind-mounted locations (see docker-compose.yml); running natively on the
# VPN server, point these at your actual clone of this repo.
OPENVPN_INSTALL_SCRIPT=/opt/openvpn-toolkit/openvpn-install.sh
VPN_STATUS_SCRIPT=/opt/openvpn-toolkit/vpn-status.py

# true if this process needs `sudo` to run the scripts (typical when running
# natively as a non-root user). Set to false if this process already runs as
# root (typical inside a container granted host access via bind-mounts).
USE_SUDO=true

HOST=0.0.0.0
PORT=8000

# Created once on first startup if no admin user exists yet. Leave unset to
# force an explicit choice rather than shipping a guessable default.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Roles are fully dynamic (admin/editor/viewer/vpn_self_service seeded
# automatically, plus any custom role created from the Roles page) -- no
# env var controls them, nothing to set here. See app/README.md's "Roles &
# Permissions" section. Deployments upgrading from a version that predates
# this feature should run `python migrate_vpn_profiles.py preview` (then
# `run`) once, from inside the app container, to link existing VPN clients
# to portal accounts -- same section of app/README.md covers this.

# Branding -- purely cosmetic, shown in the sidebar header, login page, and
# footer. Safe to leave at the defaults; no value here is tied to any
# specific person or organization.
#
# NOTE: everything below (branding, SMTP, and also the security/audit-log
# settings that have no env var at all) is now also editable at runtime,
# app-wide, with no restart, from the admin-only Settings page (/settings).
# These env vars remain only the seed/fallback default for whatever hasn't
# been changed there yet -- see vpnadmin/app_settings.py.
APP_NAME=OpenVPN Toolkit
APP_TAGLINE=Sign in to manage clients, MACs & live status
APP_FOOTER_CREDIT=

# Outbound email (SMTP) -- optional. Only used by the "email a client's
# .ovpn profile" action. Leave SMTP_HOST blank to keep that feature disabled
# (the API returns a clear error instead of crashing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Per-client restrictions (country / OS / bandwidth quota) ---
# See README.md's "Per-client restrictions" section. Each client's country
# restriction (if any) is picked independently from a full country
# dropdown in the "Manage Restrictions" dialog -- no deployment-level
# setting here.
#
# Paths to the two JSON files backing this feature -- bind-mounted from the
# OpenVPN host under /etc/openvpn (see docker-compose.yml), same mount as
# openvpn_db.txt. Only change these if your deployment customized
# CLIENT_POLICY_FILE/CLIENT_USAGE_FILE in vpn-tools.conf too.
CLIENT_POLICY_FILE=/etc/openvpn/server/policy/client_policy.json
CLIENT_USAGE_FILE=/etc/openvpn/server/policy/client_usage.json

# --- Admin login restrictions (country / city / ASN / IP allowlisting) ---
# Per-user, admin-configured on the Users page -- see README.md's "Login
# restrictions" section. The country/city/ASN checks each need their own
# MaxMind GeoLite2 database (Country/City/ASN editions are separate
# files), same ones the per-client VPN restriction feature above can use
# (see vpn-tools.conf.example's MAXMIND_DB_PATH for how to obtain them),
# read directly by the web app itself this time, not via a host script.
# Each is independent -- leave any one unset if you don't use that kind of
# login restriction, and it simply fails closed (blocks) for any user who
# has that restriction type enabled, same fail-safe stance as the VPN
# client version. The IP check needs no database at all (see client_ip.py).
# The City/ASN admin-picker lists (see geo_lists.py) are built by walking
# the whole City/ASN mmdb once in the background (~90-100s + ~15s) and
# cached to a JSON file next to each source mmdb -- no extra volume or
# permission needed beyond the rw bind-mount these paths already require.
GEOIP_DB_PATH=/etc/openvpn/server/GeoLite2-Country.mmdb
GEOIP_CITY_DB_PATH=/etc/openvpn/server/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=/etc/openvpn/server/GeoLite2-ASN.mmdb

# --- Real client IP source (proxy/CDN detection) -------------------------
# Which header client_ip.py trusts for the visitor's real IP -- feeds every
# restriction check above plus the MaxMind lookups. Normally auto-populated
# by setup-new-machine.sh's detect_proxy_mode() based on how APP_DOMAIN's
# DNS actually resolves (Cloudflare-proxied vs. direct/any other DNS
# provider) -- safe to hand-edit here afterward for a setup it can't infer
# (e.g. your own reverse proxy in front of Traefik). See config.py's
# CLIENT_IP_HEADER docstring for the full set of accepted values.
# CLIENT_IP_TRUST_MIDDLEWARE pairs with it: "cloudflare-only" makes Traefik
# itself (see app/traefik/dynamic.yml.tmpl) reject any connection not from
# Cloudflare's published edge ranges; "allow-all" applies no such
# enforcement. Leaving both unset defaults to CF-Connecting-IP-if-present
# else X-Forwarded-For's rightmost hop, with no Traefik-level enforcement --
# the same behavior this app always had before these two vars existed.
# CLIENT_IP_HEADER=CF-Connecting-IP
# CLIENT_IP_TRUST_MIDDLEWARE=cloudflare-only

# --- Host executor (Phase 1 Python service layer -- web-triggered
# install/uninstall only, see
# /home/hackx/.claude/plans/openvpn-bash-to-python-migration-lazy-neumann.md) ---
# Optional. Leave HOST_SSH_TARGET unset to keep the Install/Uninstall admin
# action disabled (clear 400, everything else in the app is unaffected).
# When set, the app SSHes to HOST_SSH_TARGET using the key at
# /run/secrets/openvpn-toolkit-deploy-key inside this container (see
# docker-compose.yml's app volumes -- HOST_SSH_KEY_SOURCE_PATH below picks
# where that key lives on the HOST; leave it at the default if you put the
# key at ./secrets/openvpn-toolkit-deploy-key next to this file) to run
# exactly app/cli/openvpn_admin.py on the host -- see that module's
# docstring. The corresponding host-side authorized_keys entry should use a
# forced `command=` wrapper restricted to that one command (see the
# migration plan's §2a) -- a bare key with no such restriction would let
# this app run arbitrary commands as whatever user/privilege the key logs
# in as, defeating the whole point of keeping this out of the app
# container's own Docker privileges.
# HOST_SSH_TARGET=ubuntu@203.0.113.10
# HOST_SSH_KEY_SOURCE_PATH=./secrets/openvpn-toolkit-deploy-key
HOST_SSH_PORT=22
HOST_SSH_REMOTE_SCRIPT_PATH=/opt/openvpn-toolkit/app/cli/openvpn_admin.py
HOST_SSH_USE_SUDO=true
HOST_SSH_TIMEOUT_SECONDS=180
